# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_DB=toolbox
POSTGRES_USER=toolbox
POSTGRES_PASSWORD=toolbox_dev_password
POSTGRES_PORT=5432

# ─── API ──────────────────────────────────────────────────
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
ApiConnectionStrings__Default=Host=postgres;Port=5432;Database=toolbox;Username=toolbox;Password=toolbox_dev_password

# ─── UI ───────────────────────────────────────────────────
UI_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

# ─── AWS / SQS ────────────────────────────────────────────
# Local: LocalStack. Production: real AWS credentials via IAM role or env.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SQS_QUEUE_NAME=toolbox-run-requests
AWS_SQS_ENDPOINT=http://localstack:4566
AWS_SQS_ENDPOINT_HOST=http://localhost:4566

# ─── Seq (local log viewer) ───────────────────────────────
SEQ_PORT=5341
SEQ_INGESTION_URL=http://seq:5341

# ─── New Relic (production only — leave blank locally) ───
NEWRELIC_LICENSE_KEY=

# ─── Polling Service ──────────────────────────────────────
# In production these are configured in appsettings.Production.json
PollingService__ApiBaseUrl=http://localhost:8080
PollingService__ExecutablesRoot=C:\\ToolboxApps
